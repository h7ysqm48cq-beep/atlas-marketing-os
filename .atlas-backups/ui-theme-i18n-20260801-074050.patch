ring\n  startOffset Int?\n  endOffset   Int?\n  vector      Json\n  model       String\n  dimensions  Int\n  contentHash String\n  embeddedAt  DateTime          @default(now())\n  updatedAt   DateTime          @updatedAt\n\n  @@unique([documentId, chunkIndex])\n  @@index([documentId])\n  @@index([brandId])\n  @@index([embeddedAt])\n}\n\nenum AiUsageFeature {\n  CONTENT_GENERATION\n  COPILOT_CHAT\n  COPILOT_MARKETING_PLAN\n  OTHER\n}\n\nmodel AiUsage {\n  id String @id @default(cuid())\n\n  historyId String?\n  history   GenerationHistory? @relation(fields: [historyId], references: [id], onDelete: SetNull)\n\n  conversationId String?\n\n  feature AiUsageFeature @default(OTHER)\n  model   String\n\n  promptTokens      Int\n  cachedInputTokens Int @default(0)\n  completionTokens  Int\n  reasoningTokens   Int @default(0)\n  totalTokens       Int\n\n  estimatedCostUsd Float\n  estimatedCostMyr Float\n\n  durationMs Int\n\n  createdAt DateTime @default(now())\n\n  @@index([historyId])\n  @@index([conversationId])\n  @@index([feature])\n  @@index([model])\n  @@index([createdAt])\n}\n\nenum SocialPlatform {\n  FACEBOOK\n  TELEGRAM\n}\n\nenum SocialChannelStatus {\n  DISCONNECTED\n  CONNECTED\n  EXPIRED\n  ERROR\n}\n\nenum ScheduledPostStatus {\n  DRAFT\n  SCHEDULED\n  QUEUED\n  PUBLISHING\n  PUBLISHED\n  FAILED\n  CANCELLED\n}\n\nenum PublishAttemptStatus {\n  PENDING\n  SUCCESS\n  FAILED\n}\n\nmodel SocialChannel {\n  id          String    @id @default(cuid())\n  workspaceId String\n  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)\n  brandId     String\n  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)\n\n  platform   SocialPlatform\n  name       String\n  externalId String?\n  username   String?\n  status     SocialChannelStatus @default(DISCONNECTED)\n\n  accessTokenEncrypted String?\n  tokenExpiresAt       DateTime?\n  lastConnectedAt      DateTime?\n  lastError            String?\n\n  scheduledPosts ScheduledPost[]\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  @@unique([brandId, platform, externalId])\n  @@index([workspaceId])\n  @@index([brandId])\n  @@index([platform])\n  @@index([status])\n}\n\nmodel ScheduledPost {\n  id         String             @id @default(cuid())\n  brandId    String\n  brand      Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)\n  channelId  String\n  channel    SocialChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)\n  campaignId String?\n  campaign   Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)\n  historyId  String?\n  history    GenerationHistory? @relation(fields: [historyId], references: [id], onDelete: SetNull)\n\n  platform  SocialPlatform\n  title     String?\n  content   String\n  mediaUrls String[]\n\n  scheduledAt DateTime\n  timezone    String              @default(\"Asia/Kuala_Lumpur\")\n  status      ScheduledPostStatus @default(DRAFT)\n\n  publishedAt     DateTime?\n  externalPostId  String?\n  externalPostUrl String?\n  lastError       String?\n  retryCount      Int       @default(0)\n\n  attempts PublishAttempt[]\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  @@index([brandId])\n  @@index([channelId])\n  @@index([campaignId])\n  @@index([historyId])\n  @@index([platform])\n  @@index([status])\n  @@index([scheduledAt])\n}\n\nmodel PublishAttempt {\n  id              String        @id @default(cuid())\n  scheduledPostId String\n  scheduledPost   ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)\n\n  attemptNumber Int\n  status        PublishAttemptStatus @default(PENDING)\n\n  requestPayload  Json?\n  responsePayload Json?\n  errorMessage    String?\n  startedAt       DateTime  @default(now())\n  completedAt     DateTime?\n\n  createdAt DateTime @default(now())\n\n  @@index([scheduledPostId])\n  @@