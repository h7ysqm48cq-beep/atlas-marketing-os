e)\n  campaignId     String?\n  campaign       Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)\n  ideaId         String?\n  idea           CampaignIdea?    @relation(fields: [ideaId], references: [id], onDelete: SetNull)\n  topic          String\n  platforms      String[]\n  style          String\n  language       String\n  facebook       String\n  telegram       String\n  reels          String\n  imagePrompt    String\n  analysis       Json\n  isFavorite     Boolean          @default(false)\n  status         ContentStatus    @default(DRAFT)\n  reviewNote     String?\n  reviewedBy     String?\n  reviewedAt     DateTime?\n  approvedAt     DateTime?\n  publishedAt    DateTime?\n  usageLogs      AiUsage[]\n  assets         Asset[]\n  createdAt      DateTime         @default(now())\n  updatedAt      DateTime         @updatedAt\n  scheduledPosts ScheduledPost[]\n\n  @@index([brandId])\n  @@index([campaignId])\n  @@index([ideaId])\n  @@index([createdAt])\n  @@index([status])\n}\n\nmodel ContentVersion {\n  id            String            @id @default(cuid())\n  historyId     String\n  history       GenerationHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)\n  platform      String\n  content       String\n  sourceAction  String\n  versionNumber Int\n  createdAt     DateTime          @default(now())\n\n  @@unique([historyId, platform, versionNumber])\n  @@index([historyId])\n  @@index([platform])\n  @@index([createdAt])\n}\n\nmodel Asset {\n  id         String             @id @default(cuid())\n  brandId    String\n  brand      Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)\n  campaignId String?\n  campaign   Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)\n  historyId  String?\n  history    GenerationHistory? @relation(fields: [historyId], references: [id], onDelete: SetNull)\n\n  name     String\n  type     AssetType @default(IMAGE)