+                    f"{extends_text}"
+                    f"{implements_text}"
+                ),
+            )
+            if item
+        ]
+
+        class_header = " ".join(
+            class_header_parts
+        )
+
+        normalized_body = body.strip(
+            "\r\n"
+        )
+
+        if normalized_body.strip():
+            rendered_body = "\n".join(
+                (
+                    "  " + line
+                    if line.strip()
+                    else ""
+                )
+                for line
+                in normalized_body.splitlines()
+            )
+
+            class_text = (
+                f"{class_header} {{\n"
+                f"{rendered_body}\n"
+                "}"
+            )
+        else:
+            class_text = (
+                f"{class_header} {{}}"
+            )
+
+        if decorator_text:
+            class_text = (
+                decorator_text
+                + "\n"
+                + class_text
+            )
+
+        return self.add_class_text(
+            class_text,
+            before=before,
+            after=after,
+            position=position,
+        )
