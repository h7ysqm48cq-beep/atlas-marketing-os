+
+        kind = kind.strip()
+
+        if not declaration_name:
+            raise ValueError(
+                "declaration_name cannot be empty"
+            )
+
+        if not declaration_text.strip():
+            raise ValueError(
+                "declaration_text cannot be empty"
+            )
+
+        if not kind:
+            raise ValueError(
+                "kind cannot be empty"
+            )
+
+        for field_name, value in (
+            ("before", before),
+            ("after", after),
+            ("position", position),
+        ):
+            if (
+                value is not None
+                and not isinstance(value, str)
+            ):
+                raise TypeError(
+                    f"{field_name} must be a "
+                    "string or None"
+                )
+
+        before = (
+            before.strip()
+            if before is not None
+            else None
+        )
+
+        after = (
+            after.strip()
+            if after is not None
+            else None
+        )
+
+        position = (
+            position.strip()
+            if position is not None
+            else None
+        )
+
+        current_source = self.source()
+
+        result = self._bridge.parse_source(
+            current_source,
+            suffix=self.path.suffix,
+        )
+
+        navigator = ASTNavigator(result)
+
+        try:
+            plan = (
+                DeclarationAddPlanner().plan(
+                    DeclarationAddContext(
+                        source=current_source,
+                        declaration_name=(
+                            declaration_name
+                        ),
+                        declaration_kind=kind,
+                        declaration_text=(
+                            declaration_text
+                        ),
+                        declarations=(
+                            navigator.declarations()
+                        ),
+                        imports=(
+                            navigator.imports()
+                        ),
+                        before=before,
+                        after=after,
