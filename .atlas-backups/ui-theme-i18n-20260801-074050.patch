+
+        for edit in plan.edits:
+            editor.replace(
+                edit.start,
+                edit.end,
+                edit.text,
+            )
+
+        changed = editor.apply()
+
+        if not changed:
+            return False
+
+        self._current_text = editor.source()
+        self._ast_import_edits_active = True
+
+        self.operations.append(
