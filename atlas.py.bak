#!/usr/bin/env python3

import json
import sys
from urllib.request import Request, urlopen
from urllib.error import HTTPError, URLError

API = "http://localhost:3001"


def request(method, path, body=None):
    url = API + path

    headers = {
        "Content-Type": "application/json",
    }

    data = None

    if body is not None:
        data = json.dumps(body).encode()

    req = Request(
        url,
        data=data,
        headers=headers,
        method=method,
    )

    try:
        with urlopen(req) as r:
            return json.loads(r.read().decode())

    except HTTPError as e:
        print(e.read().decode())
        sys.exit(1)

    except URLError:
        print("Cannot connect to Atlas API.")
        sys.exit(1)


def pretty(obj):
    print(json.dumps(obj, indent=4))


def latest():
    posts = request("GET", "/automation/posts")

    fb = [
        p
        for p in posts
        if p["platform"] == "FACEBOOK"
    ]

    if not fb:
        print("No Facebook posts.")
        return

    post = fb[-1]

    pretty(
        request(
            "GET",
            f"/automation/posts/{post['id']}",
        )
    )


def channels():
    pretty(
        request(
            "GET",
            "/automation/channels",
        )
    )


def dashboard():
    pretty(
        request(
            "GET",
            "/automation/dashboard",
        )
    )


def settings():
    pretty(
        request(
            "GET",
            "/automation/settings",
        )
    )


def run():
    pretty(
        request(
            "POST",
            "/automation/run",
            {},
        )
    )


def facebook_test():
    pretty(
        request(
            "POST",
            "/automation/facebook/test",
            {},
        )
    )


def telegram_test():
    pretty(
        request(
            "POST",
            "/automation/telegram/test",
            {},
        )
    )


def help():
    print(
"""
Atlas CLI

python3 atlas.py latest
python3 atlas.py run
python3 atlas.py channels
python3 atlas.py dashboard
python3 atlas.py settings
python3 atlas.py fbtest
python3 atlas.py tgtest
"""
    )


COMMANDS = {
    "latest": latest,
    "run": run,
    "channels": channels,
    "dashboard": dashboard,
    "settings": settings,
    "fbtest": facebook_test,
    "tgtest": telegram_test,
}


if len(sys.argv) != 2:
    help()
    sys.exit(0)

cmd = sys.argv[1]

if cmd not in COMMANDS:
    help()
    sys.exit(1)

COMMANDS[cmd]()
