from __future__ import annotations

import unittest

from tools.modifier.constructor_parameter import (
    ConstructorParameter,
)
from tools.modifier.parameter_insertion import (
    ConstructorShape,
    EmptyConstructorInsertionStrategy,
    MultilineParameterInsertionStrategy,
    ParameterInsertionContext,
    ParameterInsertionPlanner,
)


class ParameterInsertionTests(unittest.TestCase):
    def parameter(
        self,
    ) -> ConstructorParameter:
        return ConstructorParameter(
            name="logger",
            type="Logger",
        )

    def context(
        self,
        source: str,
        *,
        last_start: int | None = None,
        last_end: int | None = None,
    ) -> ParameterInsertionContext:
        constructor_start = source.index(
            "constructor"
        )
        body_start = source.index(
            "{",
            constructor_start,
        )

        return ParameterInsertionContext(
            source=source,
            constructor_start=constructor_start,
            body_start=body_start,
            constructor_indent="  ",
            parameter=self.parameter(),
            last_parameter_start=last_start,
            last_parameter_end=last_end,
        )

    def test_empty_constructor_supported(
        self,
    ) -> None:
        source = """export class AppService {
  constructor() {}
}
"""

        context = self.context(source)
        strategy = (
            EmptyConstructorInsertionStrategy()
        )

        self.assertTrue(
            strategy.supports(context)
        )

        insertion = strategy.plan(context)

        self.assertEqual(
            insertion.shape,
            ConstructorShape.EMPTY,
        )

        result = (
            source[:insertion.index]
            + insertion.text
            + source[insertion.index:]
        )

        self.assertEqual(
            result,
            """export class AppService {
  constructor(
    private readonly logger: Logger,
  ) {}
}
""",
        )

    def test_empty_constructor_rejects_content(
        self,
    ) -> None:
        source = """export class AppService {
  constructor(private config: Config) {}
}
"""

        context = self.context(source)

        self.assertFalse(
            EmptyConstructorInsertionStrategy()
            .supports(context)
        )

    def test_multiline_with_trailing_comma(
        self,
    ) -> None:
        source = """export class AppService {
  constructor(
    private readonly config: ConfigService,
  ) {}
}
"""

        start = source.index(
            "private readonly config"
        )
        end = start + len(
            "private readonly config: ConfigService"
        )

        context = self.context(
            source,
            last_start=start,
            last_end=end,
        )

        insertion = (
            MultilineParameterInsertionStrategy()
            .plan(context)
        )

        result = (
            source[:insertion.index]
            + insertion.text
            + source[insertion.index:]
        )

        self.assertEqual(
            result,
            """export class AppService {
  constructor(
    private readonly config: ConfigService,
    private readonly logger: Logger,
  ) {}
}
""",
        )

    def test_multiline_without_trailing_comma(
        self,
    ) -> None:
        source = """export class AppService {
  constructor(
    private readonly config: ConfigService
  ) {}
}
"""

        start = source.index(
            "private readonly config"
        )
        end = start + len(
            "private readonly config: ConfigService"
        )

        context = self.context(
            source,
            last_start=start,
            last_end=end,
        )

        insertion = (
            MultilineParameterInsertionStrategy()
            .plan(context)
        )

        result = (
            source[:insertion.index]
            + insertion.text
            + source[insertion.index:]
        )

        self.assertEqual(
            result,
            """export class AppService {
  constructor(
    private readonly config: ConfigService,
    private readonly logger: Logger
  ) {}
}
""",
        )

    def test_planner_selects_empty_strategy(
        self,
    ) -> None:
        source = """export class AppService {
  constructor() {}
}
"""

        insertion = ParameterInsertionPlanner().plan(
            self.context(source)
        )

        self.assertEqual(
            insertion.shape,
            ConstructorShape.EMPTY,
        )

    def test_planner_selects_multiline_strategy(
        self,
    ) -> None:
        source = """export class AppService {
  constructor(
    private readonly config: ConfigService,
  ) {}
}
"""

        start = source.index(
            "private readonly config"
        )
        end = start + len(
            "private readonly config: ConfigService"
        )

        insertion = ParameterInsertionPlanner().plan(
            self.context(
                source,
                last_start=start,
                last_end=end,
            )
        )

        self.assertEqual(
            insertion.shape,
            ConstructorShape
            .MULTILINE_WITH_PARAMETERS,
        )

    def test_planner_supports_single_line(...)
        self,
    ) -> None:
        source = """export class AppService {
  constructor(private config: Config) {}
}
"""

        start = source.index("private config")
        end = start + len(
            "private config: Config"
        )

        with self.assertRaises(ValueError):
            ParameterInsertionPlanner().plan(
                self.context(
                    source,
                    last_start=start,
                    last_end=end,
                )
            )


if __name__ == "__main__":
    unittest.main()
