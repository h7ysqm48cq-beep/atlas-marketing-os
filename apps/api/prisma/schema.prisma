model AiRuntimeSetting {
  id                             String   @id @default(cuid())
  textModel                      String   @default("gpt-5.6-luna")
  imageModel                     String   @default("gpt-image-2")
  embeddingModel                 String   @default("text-embedding-3-large")
  sportsNewsModel                String   @default("gpt-5.6-luna")
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
  aiStudioModel                  String   @default("gpt-5.6-luna")
  aiStudioInstructions           String   @default("")
  aiStudioTimeoutMs              Int      @default(30000)
  aiStudioRetryLimit             Int      @default(1)
  copilotModel                   String   @default("gpt-5.6-luna")
  copilotInstructions            String   @default("")
  copilotKnowledgeLimit          Int      @default(4)
  copilotConversationRecallLimit Int      @default(7)
  copilotStudioHistoryLimit      Int      @default(5)
  copilotContextMaxChars         Int      @default(7500)
  imageGenerationInstructions    String   @default("")
  imageNegativeInstructions      String   @default("")
  imageModelLogoEnabled          Boolean  @default(false)
  imageAtlasLogoOverlayEnabled   Boolean  @default(true)
}

model AutomationSetting {
  id                  String    @id @default(cuid())
  workspaceId         String    @unique
  timezone            String    @default("Asia/Kuala_Lumpur")
  approvalRequired    Boolean   @default(true)
  autoPublishEnabled  Boolean   @default(false)
  retryLimit          Int       @default(3)
  retryDelayMinutes   Int       @default(10)
  defaultFacebookTime String    @default("20:00")
  defaultTelegramTime String    @default("20:05")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CopilotConversation {
  id                           String                        @id @default(cuid())
  brandId                      String
  campaignId                   String?
  title                        String
  mode                         String                        @default("chat")
  isArchived                   Boolean                       @default(false)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  brand                        Brand                         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign                     Campaign?                     @relation(fields: [campaignId], references: [id])
  copilotConversationEmbedding CopilotConversationEmbedding?
  messages                     CopilotConversationMessage[]

  @@index([brandId])
  @@index([campaignId])
  @@index([updatedAt])
  @@index([isArchived])
}

model CopilotConversationEmbedding {
  id             String              @id @default(cuid())
  brandId        String
  conversationId String              @unique
  content        String
  vector         Json
  model          String
  dimensions     Int
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  brand          Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([createdAt])
}

model CopilotConversationMessage {
  id             String              @id @default(cuid())
  conversationId String
  role           CopilotMessageRole
  content        String
  metadata       Json?
  createdAt      DateTime            @default(now())
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  brandId     String
  title       String
  category    String
  content     String
  description String?
  isFavorite  Boolean  @default(false)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([brandId, category])
  @@index([brandId, isFavorite])
  @@index([updatedAt])
}

model BrandMemoryFact {
  id          String                @id @default(cuid())
  brandId     String
  type        BrandMemoryFactType   @default(PREFERENCE)
  key         String
  value       String
  description String?
  confidence  Int                   @default(80)
  status      BrandMemoryFactStatus @default(CANDIDATE)
  sourceType  String                @default("manual")
  sourceId    String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  confirmedAt DateTime?
  rejectedAt  DateTime?
  brand       Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([brandId, status])
  @@index([brandId, type])
  @@index([updatedAt])
}

model EngineeringSnapshot {
  id          String   @id @default(cuid())
  files       Json
  description String
  backupPath  String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

model EngineeringAudit {
  id            String   @id @default(uuid())
  action        String
  filePath      String
  riskLevel     String
  confidence    Float
  approvalState String
  status        String
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([filePath])
}

model ImageGenerationSetting {
  id                  String    @id @default(cuid())
  workspaceId         String
  pageId              String?
  channelId           String?
  textOverlayEnabled  Boolean   @default(true)
  brandFooterEnabled  Boolean   @default(true)
  footerText          String    @default("满贯门 mgmbetmyr.com")
  footerPosition      String    @default("bottom-center")
  footerStyle         String    @default("minimal")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  footerLogoMode      String    @default("auto")
  cornerLogoEnabled   Boolean   @default(false)
  cornerLogoPlacement String    @default("TOP_RIGHT")
  cornerLogoScale     Float     @default(1)
  cornerLogoOpacity   Float     @default(1)
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([pageId])
  @@index([channelId])
}

