generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BrandStatus {
  ACTIVE
  ARCHIVED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CampaignIdeaStatus {
  PLANNED
  GENERATED
  APPROVED
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  AI_IMPROVED
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum AssetType {
  IMAGE
  VIDEO
  DOCUMENT
  TEMPLATE
}

enum BackgroundJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum BackgroundJobType {
  AI_STUDIO
  COPILOT_CHAT
  COPILOT_MARKETING_PLAN
}

model BackgroundJob {
  id          String              @id @default(cuid())
  type        BackgroundJobType
  status      BackgroundJobStatus @default(QUEUED)
  payload     Json
  result      Json?
  error       String?
  attempts    Int                 @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([type, status, createdAt])
  @@index([createdAt])
}

model Workspace {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  brands            Brand[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  socialChannels    SocialChannel[]
  automationSetting AutomationSetting?
}

model Brand {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  website         String?
  industry        String?
  country         String    @default("Malaysia")
  primaryLanguage String    @default("Chinese")
  targetAudience  String
  brandVoice      String
  visualStyle     String
  contentGoals    String
  callsToAction   String[]
  keywords        String[]
  forbiddenWords  String[]
  brandRules      String[]
  examplePosts    String[]

  primaryLogoAssetId String?
  brandBannerAssetId String?
  mascotAssetId      String?
  referenceAssetIds  String[] @default([])

  status               BrandStatus           @default(ACTIVE)
  generations          GenerationHistory[]
  campaigns            Campaign[]
  assets               Asset[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  knowledgeDocuments   KnowledgeDocument[]
  socialChannels       SocialChannel[]
  scheduledPosts       ScheduledPost[]
  copilotConversations CopilotConversation[]
  promptTemplates      PromptTemplate[]
  memoryFacts          BrandMemoryFact[]

  @@index([workspaceId])
}

model Campaign {
  id                   String                @id @default(cuid())
  brandId              String
  brand                Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  objective            String?
  status               CampaignStatus        @default(DRAFT)
  startDate            DateTime?
  endDate              DateTime?
  ideas                CampaignIdea[]
  generations          GenerationHistory[]
  assets               Asset[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  scheduledPosts       ScheduledPost[]
  copilotConversations CopilotConversation[]

  @@index([brandId])
  @@index([status])
}

model CampaignIdea {
  id          String              @id @default(cuid())
  campaignId  String
  campaign    Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String
  angle       String
  hook        String
  platform    String
  style       String
  language    String
  status      CampaignIdeaStatus  @default(PLANNED)
  sortOrder   Int                 @default(0)
  generations GenerationHistory[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([campaignId])
  @@index([status])
  @@index([sortOrder])
}

model GenerationHistory {
  versions                      ContentVersion[]
  id                            String                       @id @default(cuid())
  brandId                       String
  brand                         Brand                        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignId                    String?
  campaign                      Campaign?                    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  ideaId                        String?
  idea                          CampaignIdea?                @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  topic                         String
  platforms                     String[]
  style                         String
  language                      String
  facebook                      String
  telegram                      String
  reels                         String
  imagePrompt                   String
  analysis                      Json
  isFavorite                    Boolean                      @default(false)
  status                        ContentStatus                @default(DRAFT)
  reviewNote                    String?
  reviewedBy                    String?
  reviewedAt                    DateTime?
  approvedAt                    DateTime?
  publishedAt                   DateTime?
  usageLogs                     AiUsage[]
  assets                        Asset[]
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  scheduledPosts                ScheduledPost[]
  runtimeProfile                SocialChannelRuntimeProfile? @relation(fields: [socialChannelRuntimeProfileId], references: [id])
  socialChannelRuntimeProfileId String?

  @@index([brandId])
  @@index([campaignId])
  @@index([ideaId])
  @@index([createdAt])
  @@index([status])
}

model ContentVersion {
  id            String            @id @default(cuid())
  historyId     String
  history       GenerationHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)
  platform      String
  content       String
  sourceAction  String
  versionNumber Int
  createdAt     DateTime          @default(now())

  @@unique([historyId, platform, versionNumber])
  @@index([historyId])
  @@index([platform])
  @@index([createdAt])
}

model Asset {
  id         String             @id @default(cuid())
  brandId    String
  brand      Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  historyId  String?
  history    GenerationHistory? @relation(fields: [historyId], references: [id], onDelete: SetNull)

  name     String
  type     AssetType @default(IMAGE)
  provider String?
  platform String?

  prompt         String?
  revisedPrompt  String?
  negativePrompt String?

  generationModel      String?
  generationSize       String?
  generationQuality    String?
  generationDurationMs Int?

  url             String
  thumbnailUrl    String?
  storageProvider String?
  storagePath     String?
  fileSize        Int?

  mimeType String?
  width    Int?
  height   Int?

  tags       String[] @default([])
  collection String?
  remark     String?
  aiEnabled  Boolean  @default(true)
  isFavorite Boolean  @default(false)

  downloadCount Int       @default(0)
  usedCount     Int       @default(0)
  lastUsedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([campaignId])
  @@index([historyId])
  @@index([type])
  @@index([collection])
  @@index([isFavorite])
  @@index([createdAt])
}

model KnowledgeDocument {
  id              String               @id @default(cuid())
  brandId         String
  brand           Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  embeddings      KnowledgeEmbedding[]
  title           String
  category        String
  content         String
  tags            String[]
  sourceFileName  String?
  sourceMimeType  String?
  sourceFileSize  Int?
  sourceUrl       String?
  storageProvider String?
  storagePath     String?
  usageCount      Int                  @default(0)
  lastUsedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([brandId])
  @@index([category])
  @@index([createdAt])
}

model KnowledgeEmbedding {
  id          String            @id @default(cuid())
  documentId  String
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  brandId     String
  chunkIndex  Int
  chunkText   String
  startOffset Int?
  endOffset   Int?
  vector      Json
  model       String
  dimensions  Int
  contentHash String
  embeddedAt  DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([brandId])
  @@index([embeddedAt])
}

enum AiUsageFeature {
  CONTENT_GENERATION
  COPILOT_CHAT
  COPILOT_MARKETING_PLAN
  OTHER
}

model AiUsage {
  id String @id @default(cuid())

  historyId String?
  history   GenerationHistory? @relation(fields: [historyId], references: [id], onDelete: SetNull)

  conversationId String?

  feature AiUsageFeature @default(OTHER)
  model   String

  promptTokens      Int
  cachedInputTokens Int @default(0)
  completionTokens  Int
  reasoningTokens   Int @default(0)
  totalTokens       Int

  estimatedCostUsd Float
  estimatedCostMyr Float

  durationMs Int

  createdAt DateTime @default(now())

  @@index([historyId])
  @@index([conversationId])
  @@index([feature])
  @@index([model])
  @@index([createdAt])
}

enum SocialPlatform {
  FACEBOOK
  TELEGRAM
}

enum SocialChannelStatus {
  DISCONNECTED
  CONNECTED
  EXPIRED
  ERROR
}

enum ScheduledPostStatus {
  DRAFT
  SCHEDULED
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum PublishAttemptStatus {
  PENDING
  SUCCESS
  FAILED
}

model SocialChannel {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  platform   SocialPlatform
  name       String
  externalId String?
  username   String?
  status     SocialChannelStatus @default(DISCONNECTED)

  accessTokenEncrypted String?
  tokenExpiresAt       DateTime?
  lastConnectedAt      DateTime?
  lastError            String?

  scheduledPosts       ScheduledPost[]
  browserActionHistory BrowserActionHistory[]

  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  socialChannelRuntimeProfile SocialChannelRuntimeProfile?
  browserAccountLinks         BrowserAccountChannel[]

  @@unique([brandId, platform, externalId])
  @@index([workspaceId])
  @@index([brandId])
  @@index([platform])
  @@index([status])
}

enum SocialProxyType {
  DIRECT
  HTTP
  HTTPS
  SOCKS5
}

model SocialChannelRuntimeProfile {
  id        String        @id @default(cuid())
  channelId String        @unique
  channel   SocialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  browserProfileKey  String @unique
  browserProfileName String

  locale   String @default("en-MY")
  timezone String @default("Asia/Kuala_Lumpur")

  proxyType SocialProxyType @default(DIRECT)
  proxyHost String?
  proxyPort Int?

  proxyUsernameEncrypted String?
  proxyPasswordEncrypted String?
  proxyCountry           String?

  lastKnownIp          String?
  lastConnectionStatus String?
  lastConnectionError  String?
  lastConnectionTestAt DateTime?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  generationHistories GenerationHistory[]

  @@index([proxyType])
  @@index([proxyCountry])
}

model BrowserAccount {
  id String @id @default(cuid())

  workspaceId String?
  brandId     String?

  platform SocialPlatform @default(FACEBOOK)

  displayName        String
  browserProfileKey  String @unique
  browserProfileName String

  locale   String @default("en-MY")
  timezone String @default("Asia/Kuala_Lumpur")

  proxyType SocialProxyType @default(DIRECT)
  proxyHost String?
  proxyPort Int?

  proxyUsernameEncrypted String?
  proxyPasswordEncrypted String?
  proxyCountry           String?

  facebookUserId   String?
  facebookUserName String?

  loginStatus  String @default("PENDING")
  cookieStatus String @default("NOT_CREATED")

  lastKnownIp     String?
  lastLoginAt     DateTime?
  lastVerifiedAt  DateTime?
  lastHeartbeatAt DateTime?
  lastLoginError  String?

  channels         BrowserAccountChannel[]
  automationPolicy BrowserAutomationPolicy?
  timelineEvents   BrowserAccountEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([brandId])
  @@index([platform])
  @@index([loginStatus])
  @@index([cookieStatus])
  @@index([proxyType])
  @@index([proxyCountry])
  @@index([facebookUserId])
}

enum BrowserAccountEventStatus {
  INFO
  SUCCESS
  WARNING
  FAILED
}

model BrowserAutomationPolicy {
  id String @id @default(cuid())

  browserAccountId String         @unique
  browserAccount   BrowserAccount @relation(fields: [browserAccountId], references: [id], onDelete: Cascade)

  autoVerifyLogin   Boolean @default(true)
  autoDiscoverPages Boolean @default(true)
  autoSyncPages     Boolean @default(true)
  autoHealthCheck   Boolean @default(true)
  autoCloseBrowser  Boolean @default(false)
  autoNotifications Boolean @default(true)

  keepBrowserOpenAfterLogin Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrowserAccountEvent {
  id String @id @default(cuid())

  browserAccountId String
  browserAccount   BrowserAccount @relation(fields: [browserAccountId], references: [id], onDelete: Cascade)

  eventType String
  status    BrowserAccountEventStatus @default(INFO)
  title     String
  message   String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([browserAccountId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model BrowserAccountChannel {
  id String @id @default(cuid())

  browserAccountId String
  browserAccount   BrowserAccount @relation(fields: [browserAccountId], references: [id], onDelete: Cascade)

  channelId String
  channel   SocialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([browserAccountId, channelId])
  @@index([browserAccountId])
  @@index([channelId])
}

model ScheduledPost {
  id         String             @id @default(cuid())
  brandId    String
  brand      Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  channelId  String
  channel    SocialChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  historyId  String?
  history    GenerationHistory? @relation(fields: [historyId], references: [id], onDelete: SetNull)

  platform  SocialPlatform
  title     String?
  content   String
  mediaUrls String[]

  scheduledAt DateTime
  timezone    String              @default("Asia/Kuala_Lumpur")
  status      ScheduledPostStatus @default(DRAFT)

  publishedAt     DateTime?
  externalPostId  String?
  externalPostUrl String?
  lastError       String?
  retryCount      Int       @default(0)

  attempts PublishAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([channelId])
  @@index([campaignId])
  @@index([historyId])
  @@index([platform])
  @@index([status])
  @@index([scheduledAt])
}

model PublishAttempt {
  id              String        @id @default(cuid())
  scheduledPostId String
  scheduledPost   ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)

  attemptNumber Int
  status        PublishAttemptStatus @default(PENDING)

  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([scheduledPostId])
  @@index([status])
  @@index([createdAt])
}

enum BrowserActionType {
  PREPARE
  PUBLISH
  DISCARD
}

enum BrowserActionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum BrowserTraceStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}

model BrowserActionHistory {
  id        String        @id @default(cuid())
  channelId String
  channel   SocialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  action BrowserActionType
  status BrowserActionStatus @default(PENDING)

  flowId            String?
  browserProfileKey String?
  caption           String?
  imagePath         String?
  screenshotPath    String?

  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  createdAt DateTime @default(now())

  traces BrowserActionTrace[]

  @@index([channelId])
  @@index([flowId])
  @@index([action])
  @@index([status])
  @@index([createdAt])
}

model BrowserActionTrace {
  id              String               @id @default(cuid())
  browserActionId String
  browserAction   BrowserActionHistory @relation(fields: [browserActionId], references: [id], onDelete: Cascade)

  stepKey   String
  stepName  String
  stepOrder Int

  status BrowserTraceStatus @default(PENDING)

  metadata       Json?
  errorMessage   String?
  screenshotPath String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  createdAt DateTime @default(now())

  @@unique([browserActionId, stepOrder])
  @@index([browserActionId])
  @@index([status])
  @@index([stepKey])
  @@index([createdAt])
}

model AutomationSetting {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  timezone           String  @default("Asia/Kuala_Lumpur")
  approvalRequired   Boolean @default(true)
  autoPublishEnabled Boolean @default(false)
  retryLimit         Int     @default(3)
  retryDelayMinutes  Int     @default(10)

  defaultFacebookTime String @default("20:00")
  defaultTelegramTime String @default("20:05")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CopilotMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model CopilotConversation {
  id         String    @id @default(cuid())
  brandId    String
  brand      Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  title      String
  mode       String  @default("chat")
  isArchived Boolean @default(false)

  messages CopilotConversationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([campaignId])
  @@index([updatedAt])
  @@index([isArchived])
}

model CopilotConversationMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role     CopilotMessageRole
  content  String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title       String
  category    String
  content     String
  description String?
  isFavorite  Boolean  @default(false)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId])
  @@index([brandId, category])
  @@index([brandId, isFavorite])
  @@index([updatedAt])
}

enum BrandMemoryFactType {
  PREFERENCE
  AVOIDANCE
  AUDIENCE
  VOICE
  VISUAL
  CONTENT
  PLATFORM
  WORKFLOW
  OTHER
}

enum BrandMemoryFactStatus {
  CANDIDATE
  CONFIRMED
  REJECTED
}

model BrandMemoryFact {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  type        BrandMemoryFactType @default(PREFERENCE)
  key         String
  value       String
  description String?

  confidence Int                   @default(80)
  status     BrandMemoryFactStatus @default(CANDIDATE)

  sourceType String  @default("manual")
  sourceId   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  rejectedAt  DateTime?

  @@index([brandId])
  @@index([brandId, status])
  @@index([brandId, type])
  @@index([updatedAt])
}
