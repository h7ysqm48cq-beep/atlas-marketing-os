model AiRuntimeSetting {
  id String @id @default(cuid())

  textModel String @default("gpt-5.6-luna")

  imageModel String @default("gpt-image-2")

  embeddingModel String @default("text-embedding-3-large")

  sportsNewsModel String @default("gpt-5.6-luna")

  aiStudioModel        String @default("gpt-5.6-luna")
  aiStudioInstructions String @default("") @db.Text
  aiStudioTimeoutMs    Int    @default(30000)
  aiStudioRetryLimit   Int    @default(1)

  copilotModel                   String @default("gpt-5.6-luna")
  copilotInstructions            String @default("") @db.Text
  copilotKnowledgeLimit          Int    @default(4)
  copilotConversationRecallLimit Int    @default(7)
  copilotStudioHistoryLimit      Int    @default(5)
  copilotContextMaxChars         Int    @default(7500)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model AutomationSetting {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  timezone           String  @default("Asia/Kuala_Lumpur")
  approvalRequired   Boolean @default(true)
  autoPublishEnabled Boolean @default(false)
  retryLimit         Int     @default(3)
  retryDelayMinutes  Int     @default(10)

  defaultFacebookTime String @default("20:00")
  defaultTelegramTime String @default("20:05")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CopilotMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model CopilotConversation {
  id         String    @id @default(cuid())
  brandId    String
  brand      Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  title      String
  mode       String  @default("chat")
  isArchived Boolean @default(false)

  messages CopilotConversationMessage[]

  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  copilotConversationEmbedding CopilotConversationEmbedding?

  @@index([brandId])
  @@index([campaignId])
  @@index([updatedAt])
  @@index([isArchived])
}

model CopilotConversationEmbedding {
  id String @id @default(cuid())

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  conversationId String              @unique
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  content String
  vector  Json

  model      String
  dimensions Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([createdAt])
}

model CopilotConversationMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role     CopilotMessageRole
  content  String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title       String
  category    String
  content     String
  description String?
  isFavorite  Boolean  @default(false)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId])
  @@index([brandId, category])
  @@index([brandId, isFavorite])
  @@index([updatedAt])
}

enum BrandMemoryFactType {
  PREFERENCE
  AVOIDANCE
  AUDIENCE
  VOICE
  VISUAL
  CONTENT
  PLATFORM
  WORKFLOW
  OTHER
}

enum BrandMemoryFactStatus {
  CANDIDATE
  CONFIRMED
  REJECTED
}

model BrandMemoryFact {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  type        BrandMemoryFactType @default(PREFERENCE)
  key         String
  value       String
  description String?

  confidence Int                   @default(80)
  status     BrandMemoryFactStatus @default(CANDIDATE)

  sourceType String  @default("manual")
  sourceId   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  rejectedAt  DateTime?

  @@index([brandId])
  @@index([brandId, status])
  @@index([brandId, type])
  @@index([updatedAt])
}

model EngineeringSnapshot {
  id String @id @default(cuid())

  files Json

  description String

  backupPath String?

  status String @default("active")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

model EngineeringAudit {
  id String @id @default(uuid())

  action String

  filePath String

  riskLevel String

  confidence Float

  approvalState String

  status String

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([filePath])
}
