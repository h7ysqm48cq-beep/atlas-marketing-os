generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BrandStatus { ACTIVE ARCHIVED }
enum CampaignStatus { DRAFT ACTIVE PAUSED COMPLETED ARCHIVED }
enum CampaignIdeaStatus { PLANNED GENERATED APPROVED ARCHIVED }
enum ContentStatus { DRAFT AI_IMPROVED PENDING_REVIEW APPROVED REJECTED PUBLISHED }
enum AssetType { IMAGE VIDEO DOCUMENT TEMPLATE }

model Workspace {
  id String @id @default(cuid())
  name String
  slug String @unique
  brands Brand[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  socialChannels SocialChannel[]
  automationSetting AutomationSetting?
  sportsNewsSetting SportsNewsSetting?
}

model Brand {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  website String?
  industry String?
  country String @default("Malaysia")
  primaryLanguage String @default("Chinese")
  targetAudience String
  brandVoice String
  visualStyle String
  contentGoals String
  callsToAction String[]
  keywords String[]
  forbiddenWords String[]
  brandRules String[]
  examplePosts String[]
  status BrandStatus @default(ACTIVE)
  generations GenerationHistory[]
  campaigns Campaign[]
  assets Asset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  knowledgeDocuments KnowledgeDocument[]
  socialChannels SocialChannel[]
  scheduledPosts ScheduledPost[]
  copilotConversations CopilotConversation[]
  promptTemplates PromptTemplate[]
  memoryFacts BrandMemoryFact[]
  @@index([workspaceId])
}

model Campaign {
  id String @id @default(cuid())
  brandId String
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name String
  description String?
  objective String?
  status CampaignStatus @default(DRAFT)
  startDate DateTime?
  endDate DateTime?
  ideas CampaignIdea[]
  generations GenerationHistory[]
  assets Asset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scheduledPosts ScheduledPost[]
  copilotConversations CopilotConversation[]
  @@index([brandId])
  @@index([status])
}

model CampaignIdea {
  id String @id @default(cuid())
  campaignId String
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title String
  angle String
  hook String
  platform String
  style String
  language String
  status CampaignIdeaStatus @default(PLANNED)
  sortOrder Int @default(0)
  generations GenerationHistory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([campaignId])
  @@index([status])
  @@index([sortOrder])
}

model GenerationHistory {
  versions ContentVersion[]
  id String @id @default(cuid())
  brandId String
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  ideaId String?
  idea CampaignIdea? @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  topic String
  platforms String[]
  style String
  language String
  facebook String
  telegram String
  reels String
  imagePrompt String
  analysis Json
  isFavorite Boolean @default(false)
  status ContentStatus @default(DRAFT)
  reviewNote String?
  reviewedBy String?
  reviewedAt DateTime?
  approvedAt DateTime?
  publishedAt DateTime?
  usageLogs AiUsage[]
  assets Asset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scheduledPosts ScheduledPost[]
  @@index([brandId])
  @@index([campaignId])
  @@index([ideaId])
  @@index([createdAt])
  @@index([status])
}

model ContentVersion {
  id String @id @default(cuid())
  historyId String
  history GenerationHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)
  platform String
  content String
  sourceAction String
  versionNumber Int
  createdAt DateTime @default(now())
  @@unique([historyId, platform, versionNumber])
  @@index([historyId])
  @@index([platform])
  @@index([createdAt])
}

model Asset {
  id String @id @default(cuid())
  brandId String
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  historyId String?
  history GenerationHistory? @relation(fields: [historyId], references: [id], onDelete: SetNull)
  name String
  type AssetType @default(IMAGE)
  provider String?
  platform String?
  prompt String?
  revisedPrompt String?
  negativePrompt String?
  generationModel String?
  generationSize String?
  generationQuality String?
  generationDurationMs Int?
  url String
  thumbnailUrl String?
  storageProvider String?
  storagePath String?
  fileSize Int?
  mimeType String?
  width Int?
  height Int?
  tags String[] @default([])
  collection String?
  isFavorite Boolean @default(false)
  downloadCount Int @default(0)
  usedCount Int @default(0)
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([brandId])
  @@index([campaignId])
  @@index([historyId])
  @@index([type])
  @@index([collection])
  @@index([isFavorite])
  @@index([createdAt])
}

model KnowledgeDocument {
  id String @id @default(cuid())
  brandId String
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  embeddings KnowledgeEmbedding[]
  title String
  category String
  content String
  tags String[]
  sourceFileName String?
  sourceMimeType String?
  sourceFileSize Int?
  sourceUrl String?
  storageProvider String?
  storagePath String?
  usageCount Int @default(0)
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([brandId])
  @@index([category])
  @@index([createdAt])
}

model KnowledgeEmbedding {
  id String @id @default(cuid())
  documentId String
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  brandId String
  chunkIndex Int
  chunkText String
  startOffset Int?
  endOffset Int?
  vector Json
  model String
  dimensions Int
  contentHash String
  embeddedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([brandId])
  @@index([embeddedAt])
}

model AiUsage {
  id String @id @default(cuid())
  historyId String?
  history GenerationHistory? @relation(fields: [historyId], references: [id], onDelete: SetNull)
  model String
  promptTokens Int
  cachedInputTokens Int @default(0)
  completionTokens Int
  totalTokens Int
  estimatedCostUsd Float
  estimatedCostMyr Float
  durationMs Int
  createdAt DateTime @default(now())
  @@index([historyId])
  @@index([model])
  @@index([createdAt])
}

enum SocialPlatform { FACEBOOK TELEGRAM }
enum SocialChannelStatus { DISCONNECTED CONNECTED EXPIRED ERROR }
enum ScheduledPostStatus { DRAFT SCHEDULED QUEUED PUBLISHING PUBLISHED FAILED CANCELLED }
enum PublishAttemptStatus { PENDING SUCCESS FAILED }

model SocialChannel {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandId String
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform SocialPlatform
  name String
  externalId String?
  username String?
  status SocialChannelStatus @default(DISCONNECTED)
  accessTokenEncrypted String?
  tokenExpiresAt DateTime?
  lastConnectedAt DateTime?
  lastError String?
  scheduledPosts ScheduledPost[]
  sportsNewsTelegramSettings SportsNewsSetting[] @relation("SportsNewsTelegramChannel")
  sportsNewsFacebookSettings SportsNewsSetting[] @relation("SportsNewsFacebookChannel")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([brandId, platform, externalId])
  @@index([workspaceId])
  @@index([brandId])
  @@index([platform])
  @@index([status])
}

model ScheduledPost {
  id String @id @default(cuid())
  brandId String
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  channelId String
  channel SocialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  historyId String?
  history GenerationHistory? @relation(fields: [historyId], references: [id], onDelete: SetNull)
  platform SocialPlatform
  title String?
  content String
  mediaUrls String[]
  scheduledAt DateTime
  timezone String @default("Asia/Kuala_Lumpur")
  status ScheduledPostStatus @default(DRAFT)
  publishedAt DateTime?
  externalPostId String?
  externalPostUrl String?
  lastError String?
  retryCount Int @default(0)
  attempts PublishAttempt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([brandId])
  @@index([channelId])
  @@index([campaignId])
  @@index([historyId])
  @@index([platform])
  @@index([status])
  @@index([scheduledAt])
}

model PublishAttempt {
  id String @id @default(cuid())
  scheduledPostId String
  scheduledPost ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
  attemptNumber Int
  status PublishAttemptStatus @default(PENDING)
  requestPayload Json?
  responsePayload Json?
  errorMessage String?
  startedAt DateTime @default(now())
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@index([scheduledPostId])
  @@index([status])
  @@index([createdAt])
}

model AutomationSetting {
  id String @id @default(cuid())
  workspaceId String @unique
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  timezone String @default("Asia/Kuala_Lumpur")
  approvalRequired Boolean @default(true)
  autoPublishEnabled Boolean @default(false)
  retryLimit Int @default(3)
  retryDelayMinutes Int @default(10)
  defaultFacebookTime String @default("20:00")
  defaultTelegramTime String @default("20:05")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SportsNewsSetting {
  id String @id @default(cuid())
  workspaceId String @unique
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enabled Boolean @default(true)
  timezone String @default("Asia/Kuala_Lumpur")
  morningEnabled Boolean @default(true)
  morningTime String @default("09:00")
  eveningEnabled Boolean @default(true)
  eveningTime String @default("20:00")
  telegramEnabled Boolean @default(true)
  telegramChannelId String?
  telegramChannel SocialChannel? @relation("SportsNewsTelegramChannel", fields: [telegramChannelId], references: [id], onDelete: SetNull)
  facebookEnabled Boolean @default(false)
  facebookChannelId String?
  facebookChannel SocialChannel? @relation("SportsNewsFacebookChannel", fields: [facebookChannelId], references: [id], onDelete: SetNull)
  autoPublishEnabled Boolean @default(true)
  approvalRequired Boolean @default(false)
  language String @default("zh-en")
  sportsKnowledgeEnabled Boolean @default(true)
  discussionQuestionEnabled Boolean @default(true)
  referenceLinksEnabled Boolean @default(true)
  customPromptEnabled Boolean @default(false)
  systemPrompt String?
  morningPrompt String?
  eveningPrompt String?
  knowledgePrompt String?
  customInstructions String?
  imageEnabled Boolean @default(true)
  imagePrompt String?
  morningImagePrompt String?
  eveningImagePrompt String?
  imageAspectRatio String @default("4:5")
  imageTextMode String @default("minimal")
  imageVisualStyle String?
  logoEnabled Boolean @default(true)
  logoPosition String @default("bottom-right")
  brandFooterEnabled Boolean @default(true)
  brandFooterText String @default("满贯门 mgmbetmyr.com")
  lastMorningRunAt DateTime?
  lastEveningRunAt DateTime?
  lastRunStatus String?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([telegramChannelId])
  @@index([facebookChannelId])
}

enum CopilotMessageRole { USER ASSISTANT SYSTEM }
model CopilotConversation {
  id String @id @default(cuid())
  brandId String
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  title String
  mode String @default("chat")
  isArchived Boolean @default(false)
  messages CopilotConversationMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([brandId])
  @@index([campaignId])
  @@index([updatedAt])
  @@index([isArchived])
}
model CopilotConversationMessage {
  id String @id @default(cuid())
  conversationId String
  conversation CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role CopilotMessageRole
  content String
  metadata Json?
  createdAt DateTime @default(now())
  @@index([conversationId])
  @@index([createdAt])
}
model PromptTemplate {
  id String @id @default(cuid())
  brandId String
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title String
  category String
  content String
  description String?
  isFavorite Boolean @default(false)
  usageCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([brandId])
  @@index([brandId, category])
  @@index([brandId, isFavorite])
  @@index([updatedAt])
}
enum BrandMemoryFactType { PREFERENCE AVOIDANCE AUDIENCE VOICE VISUAL CONTENT PLATFORM WORKFLOW OTHER }
enum BrandMemoryFactStatus { CANDIDATE CONFIRMED REJECTED }
model BrandMemoryFact {
  id String @id @default(cuid())
  brandId String
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  type BrandMemoryFactType @default(PREFERENCE)
  key String
  value String
  description String?
  confidence Int @default(80)
  status BrandMemoryFactStatus @default(CANDIDATE)
  sourceType String @default("manual")
  sourceId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  confirmedAt DateTime?
  rejectedAt DateTime?
  @@index([brandId])
  @@index([brandId, status])
  @@index([brandId, type])
  @@index([updatedAt])
}
