import { Injectable } from '@nestjs/common';

export type QueuePlannerInput = {
  startDate: string;
  postingDays: Array<
    | 'SUN'
    | 'MON'
    | 'TUE'
    | 'WED'
    | 'THU'
    | 'FRI'
    | 'SAT'
  >;
  postingTime: string;
  numberOfPosts: number;
};

@Injectable()
export class QueuePlannerService {
  private readonly weekdayMap = {
    SUN: 0,
    MON: 1,
    TUE: 2,
    WED: 3,
    THU: 4,
    FRI: 5,
    SAT: 6,
  } as const;

  planQueue(
    input: QueuePlannerInput,
  ): Date[] {
    const result: Date[] = [];

    const start = new Date(
      `${input.startDate}T00:00:00`,
    );

    const [hour, minute] =
      input.postingTime
        .split(":")
        .map(Number);

    const allowedDays =
      input.postingDays.map(
        (day) => this.weekdayMap[day],
      );

    let current = new Date(start);

    while (
      result.length <
      input.numberOfPosts
    ) {
      if (
        allowedDays.includes(
          current.getDay(),
        )
      ) {
        const scheduled =
          new Date(current);

        scheduled.setHours(
          hour,
          minute,
          0,
          0,
        );

        result.push(scheduled);
      }

      current.setDate(
        current.getDate() + 1,
      );
    }

    return result;
  }
}
