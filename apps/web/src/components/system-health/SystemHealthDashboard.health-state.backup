type GroupId =
  | "core"
  | "automation"
  | "ai"
  | "copilot"
  | "content"
  | "memory"
  | "browser"
  | "sports"
  | "engineering";

type EndpointDefinition = {
  id: string;
  group: GroupId;
  label: string;
  labelZh: string;
  path: string;
  service?: "api" | "web";
  quick?: boolean;
  required?: boolean;
  acceptNotFound?: boolean;
  timeoutMs?: number;
};

type Health =
  | "idle"
  | "healthy"
  | "watch"
  | "critical";

type Sample = {
  round: number;
  ok: boolean;
  httpStatus: number;
  ms: number;
  sizeBytes: number;
  checkedAt: string;
  error?: string;
};

type Results = Record<string, Sample[]>;

