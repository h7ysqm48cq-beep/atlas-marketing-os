const QUICK_ENDPOINTS = ENDPOINTS.filter(
  (endpoint) => endpoint.quick,
);

function sleep(ms: number) {
  return new Promise<void>((resolve) => {
    window.setTimeout(resolve, ms);
  });
}

function formatLatency(ms: number | null) {
  if (ms === null) {
    return "—";
  }

  return `${(ms / 1000).toFixed(3)}s`;
}

function formatBytes(bytes: number | null) {
  if (bytes === null) {
    return "—";
  }

  if (bytes < 1024) {
    return `${bytes} B`;
  }

  if (bytes < 1024 * 1024) {
    return `${(bytes / 1024).toFixed(1)} KB`;
  }

  return `${(
    bytes /
    1024 /
    1024
  ).toFixed(2)} MB`;
}

function formatCheckedAt(
  value: string | undefined,
  language: string,
) {
  if (!value) {
    return "—";
  }

  const date = new Date(value);

  if (
    Number.isNaN(
      date.getTime(),
    )
  ) {
    return "—";
  }

  return new Intl.DateTimeFormat(
    language === "zh"
      ? "zh-CN"
      : "en-MY",
    {
      dateStyle: "medium",
      timeStyle: "medium",
    },
  ).format(date);
}

function endpointHealth(
  samples: Sample[],
): Health {
  if (!samples.length) {
    return "idle";
  }

  if (
    samples.some(
      (sample) => !sample.ok,
    )
  ) {
    return "critical";
  }

  const average =
    samples.reduce(
      (total, sample) =>
        total + sample.ms,
      0,
    ) / samples.length;

  const maximum = Math.max(
    ...samples.map(
      (sample) => sample.ms,
    ),
  );

  const maxPayload = Math.max(
    ...samples.map(
      (sample) =>
        sample.sizeBytes,
    ),
  );

  if (
    average > 5000 ||
    maximum > 10000 ||
    maxPayload >
      20 * 1024 * 1024
  ) {
    return "critical";
  }

  if (
    average > 3000 ||
    maximum > 5000 ||
    maxPayload >
      5 * 1024 * 1024
  ) {
    return "watch";
  }

  return "healthy";
}

export function SystemHealthDashboard() {
  const { language } =
    usePreferences();

  const [
    results,
    setResults,
  ] = useState<Results>({});

  const [
    clientApiUrl,
    setClientApiUrl,
  ] = useState("");

  useEffect(() => {
    setClientApiUrl(API_URL);
  }, []);

  const [
    running,
    setRunning,
  ] = useState(false);

  const [
    completedSteps,
    setCompletedSteps,
  ] = useState(0);

  const [
    targetSteps,
    setTargetSteps,
  ] = useState(0);

  const [
    currentCheck,
    setCurrentCheck,
  ] = useState("");

  const [
    lastChecked,
    setLastChecked,
  ] = useState("");

  const [
    issuesOnly,
    setIssuesOnly,
  ] = useState(false);

  const [
    query,
    setQuery,
  ] = useState("");

  const [
    storageReady,
    setStorageReady,
  ] = useState(false);

  useEffect(() => {
    try {
      const raw =
        window.localStorage.getItem(
          HEALTH_STORAGE_KEY,
        );

      if (raw) {
        const saved = JSON.parse(
          raw,
        ) as {
          results?: Results;
          lastChecked?: string;
        };

        if (
          saved.results &&
          typeof saved.results ===
            "object"
        ) {
          setResults(
            saved.results,
          );
        }

        if (
          typeof saved.lastChecked ===
          "string"
        ) {
          setLastChecked(
            saved.lastChecked,
          );
        }
      }
    } catch {
      // Ignore invalid local cache.
    } finally {
      setStorageReady(true);
    }
  }, []);

  useEffect(() => {
    if (!storageReady) {
      return;
    }

    try {
      window.localStorage.setItem(
        HEALTH_STORAGE_KEY,
        JSON.stringify({
          results,
          lastChecked,
        }),
      );
    } catch {
      // Health checks still work without local persistence.
    }
  }, [
    results,
    lastChecked,
    storageReady,
  ]);

  function ui(
    english: string,
    chinese: string,
  ) {
    return language === "zh"
      ? chinese
      : english;
  }

  const summaries = useMemo(
    () =>
      ENDPOINTS.map(
        (endpoint) => {
          const samples =
            results[
              endpoint.id
            ] ?? [];

          const successful =
            samples.filter(
              (sample) =>
                sample.ok,
            );

          const average =
            successful.length
              ? successful.reduce(
                  (
                    total,
                    sample,
                  ) =>
                    total +
                    sample.ms,
                  0,
                ) /
                successful.length
              : null;

          const minimum =
            successful.length
              ? Math.min(
                  ...successful.map(
                    (sample) =>
                      sample.ms,
                  ),
                )
              : null;

          const maximum =
            successful.length
              ? Math.max(
                  ...successful.map(
                    (sample) =>
                      sample.ms,
                  ),
                )
              : null;

          const maxPayload =
            successful.length
              ? Math.max(
                  ...successful.map(
                    (sample) =>
                      sample.sizeBytes,
                  ),
                )
              : null;

          return {
            ...endpoint,
            samples,
            latest:
              samples[
                samples.length -
                  1
              ] ?? null,
            average,
            minimum,
            maximum,
            maxPayload,
            health:
              endpointHealth(
                samples,
              ),
          };
        },
      ),
    [results],
  );

  const checkedSummaries =
    summaries.filter(
      (summary) =>
        summary.samples.length >
        0,
    );

  const healthyCount =
    checkedSummaries.filter(
      (summary) =>
        summary.health ===
        "healthy",
    ).length;

  const watchCount =
    checkedSummaries.filter(
      (summary) =>
        summary.health ===
        "watch",
    ).length;

  const criticalCount =
    checkedSummaries.filter(
      (summary) =>
        summary.health ===
        "critical",
    ).length;

  const requiredCritical =
    checkedSummaries.some(
      (summary) =>
        summary.required !==
          false &&
        summary.health ===
          "critical",
    );

  const hasAnyIssue =
    checkedSummaries.some(
      (summary) =>
        summary.health ===
          "watch" ||
        summary.health ===
          "critical",
    );

  const overallHealth: Health =
    !checkedSummaries.length
      ? "idle"
      : requiredCritical
        ? "critical"
        : hasAnyIssue
          ? "watch"
          : "healthy";

  const issues =
    summaries
      .filter(
        (summary) =>
          summary.health ===
            "critical" ||
          summary.health ===
            "watch",
      )
      .sort((a, b) => {
        if (
          a.health ===
            b.health
        ) {
          return (
            (b.latest?.ms ?? 0) -
            (a.latest?.ms ?? 0)
          );
        }

        return a.health ===
          "critical"
          ? -1
          : 1;
      });

  const progress =
    targetSteps > 0
      ? Math.round(
          Math.min(
            1,
            completedSteps /
              targetSteps,
          ) * 100,
        )
      : 0;

  function healthText(
    health: Health,
  ) {
    switch (health) {
      case "healthy":
        return ui(
          "Healthy",
          "正常",
        );
      case "watch":
        return ui(
          "Watch",
          "注意",
        );
      case "critical":
        return ui(
          "Critical",
          "异常",
        );
      default:
        return ui(
          "Not checked",
          "尚未检查",
        );
    }
  }

  function healthClass(
    health: Health,
  ) {
    switch (health) {
      case "healthy":
        return styles.healthy;
      case "watch":
        return styles.watch;
      case "critical":
        return styles.critical;
      default:
        return styles.idle;
    }
  }

  function resolveUrl(
    endpoint:
      EndpointDefinition,
  ) {
    if (
      endpoint.service ===
      "web"
    ) {
      return `${window.location.origin}${endpoint.path}`;
    }

    return `${API_URL}${endpoint.path}`;
  }

  async function measure(
    endpoint:
      EndpointDefinition,
    round: number,
  ): Promise<Sample> {
    const controller =
      new AbortController();

    const timeout =
      window.setTimeout(
        () =>
          controller.abort(),
        endpoint.timeoutMs ??
          15000,
      );

    const started =
      performance.now();

    try {
      const response =
        await fetch(
          resolveUrl(endpoint),
          {
            cache: "no-store",
            signal:
              controller.signal,
          },
        );

      const body =
        await response.arrayBuffer();

      const accepted =
        response.ok ||
        (
          endpoint.acceptNotFound &&
          response.status === 404
        );

      return {
        round,
        ok: Boolean(accepted),
        httpStatus:
          response.status,
        ms:
          performance.now() -
          started,
        sizeBytes:
          body.byteLength,
        checkedAt:
          new Date().toISOString(),
      };
    } catch (error) {
      return {
        round,
        ok: false,
        httpStatus: 0,
        ms:
          performance.now() -
          started,
        sizeBytes: 0,
        checkedAt:
          new Date().toISOString(),
        error:
          error instanceof Error
            ? error.message
            : "Request failed",
      };
    } finally {
      window.clearTimeout(
        timeout,
      );
    }
  }

  async function run(
    endpoints:
      EndpointDefinition[],
    rounds: number,
    clearAll: boolean,
  ) {
    if (running) {
      return;
    }

    setRunning(true);

    if (clearAll) {
      setResults({});
    } else {
      const targetIds =
        new Set(
          endpoints.map(
            (endpoint) =>
              endpoint.id,
          ),
        );

      setResults(
        (current) =>
          Object.fromEntries(
            Object.entries(
              current,
            ).filter(
              ([id]) =>
                !targetIds.has(
                  id,
                ),
            ),
          ),
      );
    }

    const total =
      endpoints.length *
      rounds;

    setTargetSteps(total);
    setCompletedSteps(0);

    let completed = 0;

    try {
      for (
        let round = 1;
        round <= rounds;
        round += 1
      ) {
        for (
          const endpoint
          of endpoints
        ) {
          setCurrentCheck(
            `${ui(
              "Round",
              "轮次",
            )} ${round}/${rounds} · ${
              language === "zh"
                ? endpoint.labelZh
                : endpoint.label
            }`,
          );

          const sample =
            await measure(
              endpoint,
              round,
            );

          setLastChecked(
            sample.checkedAt,
          );

          setResults(
            (current) => ({
              ...current,
              [endpoint.id]: [
                ...(
                  current[
                    endpoint.id
                  ] ?? []
                ),
                sample,
              ],
            }),
          );

          completed += 1;
          setCompletedSteps(
            completed,
          );

          /*
           * Keep the health page itself
           * from creating a burst of DB
           * connections.
           */
          await sleep(80);
        }

        if (round < rounds) {
          await sleep(800);
        }
      }

    } finally {
      setRunning(false);
      setCurrentCheck("");
    }
  }

  const normalizedQuery =
    query
      .trim()
      .toLowerCase();

  const grouped =
    GROUPS.map((group) => {
      const items =
        summaries.filter(
          (summary) => {
            if (
              summary.group !==
              group.id
            ) {
              return false;
            }

            if (
              issuesOnly &&
              (
                summary.health ===
                  "healthy" ||
                summary.health ===
                  "idle"
              )
            ) {
              return false;
            }

            if (
              !normalizedQuery
            ) {
              return true;
            }

            return [
              summary.label,
              summary.labelZh,
              summary.path,
            ].some((value) =>
              value
                .toLowerCase()
                .includes(
                  normalizedQuery,
                ),
            );
          },
        );

      return {
        ...group,
        items,
      };
    }).filter(
      (group) =>
        group.items.length >
        0,
    );

  return (
    <div
      className={
        styles.page
      }
    >
      <section
        className={
          styles.hero
        }
      >
        <div>
          <p
            className={
              styles.eyebrow
            }
          >
            ATLAS PERFORMANCE
          </p>

          <h1
            className={
              styles.title
            }
          >
            {ui(
              "System Health",
              "系统健康检查",
            )}
          </h1>

          <p
            className={
              styles.description
            }
          >
            {ui(
              "Production-safe health checks across Atlas. Read-only GET requests only.",
              "检查 Atlas 全站核心服务。只运行安全、只读的 GET 请求。",
            )}
          </p>
        </div>

        <div
          className={
            styles.actions
          }
        >
          <button
            type="button"
            className={
              styles.secondaryButton
            }
            disabled={running}
            onClick={() => {
              void run(
                QUICK_ENDPOINTS,
                1,
                false,
              );
            }}
          >
            {ui(
              "Quick check",
              "快速检查",
            )}
          </button>

          <button
            type="button"
            className={
              styles.secondaryButton
            }
            disabled={running}
            onClick={() => {
              void run(
                QUICK_ENDPOINTS,
                5,
                false,
              );
            }}
          >
            {ui(
              "Core 5 rounds",
              "核心 5 轮",
            )}
          </button>

          <button
            type="button"
            className={
              styles.primaryButton
            }
            disabled={running}
            onClick={() => {
              void run(
                ENDPOINTS,
                1,
                true,
              );
            }}
          >
            {running
              ? ui(
                  "Testing...",
                  "检查中...",
                )
              : ui(
                  "Full system check",
                  "全站检查",
                )}
          </button>
        </div>
      </section>

      <section
        className={
          styles.overviewGrid
        }
      >
        <article
          className={
            styles.overviewCard
          }
        >
          <span
            className={
              styles.overviewLabel
            }
          >
            {ui(
              "Overall",
              "整体状态",
            )}
          </span>

          <div
            className={`${styles.overallStatus} ${healthClass(
              running
                ? "watch"
                : overallHealth,
            )}`}
          >
            <span
              className={
                styles.statusDot
              }
            />

            {running
              ? ui(
                  "Running",
                  "检查中",
                )
              : healthText(
                  overallHealth,
                )}
          </div>
        </article>

        <article
          className={
            styles.overviewCard
          }
        >
          <span
            className={
              styles.overviewLabel
            }
          >
            {ui(
              "Endpoints",
              "检查点",
            )}
          </span>

          <strong
            className={
              styles.overviewValue
            }
          >
            {
              ENDPOINTS.length
            }
          </strong>
        </article>

        <article
          className={
            styles.overviewCard
          }
        >
          <span
            className={
              styles.overviewLabel
            }
          >
            {ui(
              "Healthy",
              "正常",
            )}
          </span>

          <strong
            className={`${styles.overviewValue} ${styles.healthy}`}
          >
            {healthyCount}
          </strong>
        </article>

        <article
          className={
            styles.overviewCard
          }
        >
          <span
            className={
              styles.overviewLabel
            }
          >
            {ui(
              "Watch",
              "注意",
            )}
          </span>

          <strong
            className={`${styles.overviewValue} ${styles.watch}`}
          >
            {watchCount}
          </strong>
        </article>

        <article
          className={
            styles.overviewCard
          }
        >
          <span
            className={
              styles.overviewLabel
            }
          >
            {ui(
              "Critical",
              "异常",
            )}
          </span>

          <strong
            className={`${styles.overviewValue} ${styles.critical}`}
          >
            {criticalCount}
          </strong>
        </article>

        <article
          className={
            styles.overviewCard
          }
        >
          <span
            className={
              styles.overviewLabel
            }
          >
            {ui(
              "Last checked",
              "最后检查",
            )}
          </span>

          <strong
            className={
              styles.lastChecked
            }
          >
            {formatCheckedAt(
              lastChecked,
              language,
            )}
          </strong>
        </article>
      </section>

      <section
        className={
          styles.apiCard
        }
      >
        <span>
          API
        </span>

        <code>
          {clientApiUrl || "—"}
        </code>
      </section>

      {running ? (
        <section
          className={
            styles.progressCard
          }
        >
          <div
            className={
              styles.progressHeader
            }
          >
            <span>
              {currentCheck}
            </span>

            <span>
              {completedSteps}/
              {targetSteps} ·{" "}
              {progress}%
            </span>
          </div>

          <div
            className={
              styles.progressTrack
            }
          >
            <div
              className={
                styles.progressBar
              }
              style={{
                width:
                  `${progress}%`,
              }}
            />
          </div>
        </section>
      ) : null}

      {issues.length ? (
        <section
          className={
            styles.issuesPanel
          }
        >
          <div
            className={
              styles.issuesHeader
            }
          >
            <div>
              <span>
                {ui(
                  "Issues detected",
                  "检测到问题",
                )}
              </span>

              <strong>
                {criticalCount}{" "}
                {ui(
                  "Critical",
                  "异常",
                )}
                {" · "}
                {watchCount}{" "}
                {ui(
                  "Watch",
                  "注意",
                )}
              </strong>
            </div>

            <span>
              {ui(
                "Fix these first",
                "优先检查这些项目",
              )}
            </span>
          </div>

          <div
            className={
              styles.issueGrid
            }
          >
            {issues.map(
              (summary) => (
                <article
                  key={
                    summary.id
                  }
                  className={`${styles.issueCard} ${
                    summary.health ===
                    "critical"
                      ? styles.issueCritical
                      : styles.issueWatch
                  }`}
                >
                  <div
                    className={
                      styles.issueTop
                    }
                  >
                    <div>
                      <strong>
                        {language ===
                        "zh"
                          ? summary.labelZh
                          : summary.label}
                      </strong>

                      <code>
                        {
                          summary.path
                        }
                      </code>
                    </div>

                    <span
                      className={`${styles.statusBadge} ${healthClass(
                        summary.health,
                      )}`}
                    >
                      <span
                        className={
                          styles.statusDot
                        }
                      />

                      {healthText(
                        summary.health,
                      )}
                    </span>
                  </div>

                  <div
                    className={
                      styles.issueMetrics
                    }
                  >
                    <span>
                      {ui(
                        "Latest",
                        "最新延迟",
                      )}

                      <strong>
                        {summary.latest
                          ? formatLatency(
                              summary
                                .latest
                                .ms,
                            )
                          : "—"}
                      </strong>
                    </span>

                    <span>
                      {ui(
                        "HTTP",
                        "HTTP",
                      )}

                      <strong>
                        {summary.latest
                          ? summary
                              .latest
                              .httpStatus
                          : "—"}
                      </strong>
                    </span>

                    <span>
                      {ui(
                        "Payload",
                        "数据量",
                      )}

                      <strong>
                        {formatBytes(
                          summary.maxPayload,
                        )}
                      </strong>
                    </span>

                    <span>
                      {ui(
                        "Last checked",
                        "最后检查",
                      )}

                      <strong>
                        {formatCheckedAt(
                          summary.latest
                            ?.checkedAt,
                          language,
                        )}
                      </strong>
                    </span>
                  </div>

                  {summary.latest
                    ?.error ? (
                    <p
                      className={
                        styles.issueError
                      }
                    >
                      {
                        summary.latest
                          .error
                      }
                    </p>
                  ) : null}
                </article>
              ),
            )}
          </div>
        </section>
      ) : checkedSummaries.length ? (
        <section
          className={
            styles.allClear
          }
        >
          <span
            className={
              styles.statusDot
            }
          />

          <div>
            <strong>
              {ui(
                "No current issues",
                "目前没有发现异常",
              )}
            </strong>

            <small>
              {ui(
                "All checked services are within the configured health thresholds.",
                "所有已检查服务目前都在正常健康范围内。",
              )}
            </small>
          </div>
        </section>
      ) : null}

      <section
        className={
          styles.filters
        }
      >
        <input
          value={query}
          onChange={(
            event,
          ) =>
            setQuery(
              event.target.value,
            )
          }
          placeholder={ui(
            "Search endpoint...",
            "搜索 API...",
          )}
          className={
            styles.search
          }
        />

        <label
          className={
            styles.issueToggle
          }
        >
          <input
            type="checkbox"
            checked={
              issuesOnly
            }
            onChange={(
              event,
            ) =>
              setIssuesOnly(
                event.target
                  .checked,
              )
            }
          />

          <span>
            {ui(
              "Issues only",
              "只看异常",
            )}
          </span>
        </label>
      </section>

      <div
        className={
          styles.groups
        }
      >
        {grouped.map(
          (group) => (
            <section
              className={
                styles.groupCard
              }
              key={
                group.id
              }
            >
              <div
                className={
                  styles.groupHeader
                }
              >
                <div>
                  <h2>
                    {language ===
                    "zh"
                      ? group.labelZh
                      : group.label}
                  </h2>

                  <p>
                    {language ===
                    "zh"
                      ? group.descriptionZh
                      : group.description}
                  </p>
                </div>

                <span
                  className={
                    styles.groupCount
                  }
                >
                  {
                    group.items
                      .length
                  }
                </span>
              </div>

              <div
                className={
                  styles.endpointTable
                }
              >
                <div
                  className={
                    styles.tableHeader
                  }
                >
                  <span>
                    {ui(
                      "Service",
                      "服务",
                    )}
                  </span>
                  <span>
                    HTTP
                  </span>
                  <span>
                    {ui(
                      "Latest",
                      "最新",
                    )}
                  </span>
                  <span>
                    {ui(
                      "Average",
                      "平均",
                    )}
                  </span>
                  <span>
                    {ui(
                      "Slowest",
                      "最慢",
                    )}
                  </span>
                  <span>
                    {ui(
                      "Payload",
                      "数据量",
                    )}
                  </span>
                  <span>
                    {ui(
                      "Last check",
                      "最后检查",
                    )}
                  </span>
                  <span>
                    {ui(
                      "Status",
                      "状态",
                    )}
                  </span>
                </div>

                {group.items.map(
                  (summary) => (
                    <div
                      className={`${styles.endpointBlock} ${
                        summary.health ===
                        "critical"
                          ? styles.endpointCritical
                          : summary.health ===
                              "watch"
                            ? styles.endpointWatch
                            : ""
                      }`}
                      key={
                        summary.id
                      }
                    >
                      <div
                        className={
                          styles.endpointRow
                        }
                      >
                        <div
                          className={
                            styles.endpointIdentity
                          }
                        >
                          <strong>
                            {language ===
                            "zh"
                              ? summary.labelZh
                              : summary.label}
                          </strong>

                          <code>
                            {
                              summary.path
                            }
                          </code>

                          {summary.required ===
                          false ? (
                            <small>
                              {ui(
                                "Optional",
                                "辅助",
                              )}
                            </small>
                          ) : null}
                        </div>

                        <span>
                          {summary.latest
                            ? `HTTP ${summary.latest.httpStatus}`
                            : "—"}
                        </span>

                        <strong>
                          {summary.latest
                            ? formatLatency(
                                summary.latest
                                  .ms,
                              )
                            : "—"}
                        </strong>

                        <span>
                          {formatLatency(
                            summary.average,
                          )}
                        </span>

                        <span>
                          {formatLatency(
                            summary.maximum,
                          )}
                        </span>

                        <span>
                          {formatBytes(
                            summary.maxPayload,
                          )}
                        </span>

                        <time
                          className={
                            styles.endpointLastChecked
                          }
                        >
                          {formatCheckedAt(
                            summary.latest
                              ?.checkedAt,
                            language,
                          )}
                        </time>

                        <span
                          className={`${styles.statusBadge} ${healthClass(
                            summary.health,
                          )}`}
                        >
                          <span
                            className={
                              styles.statusDot
                            }
                          />

                          {healthText(
                            summary.health,
                          )}
                        </span>
                      </div>

                      {summary.samples
                        .length >
                      1 ? (
                        <div
                          className={
                            styles.sampleStrip
                          }
                        >
                          {summary.samples.map(
                            (
                              sample,
                            ) => (
                              <span
                                key={`${summary.id}-${sample.round}`}
                                className={`${styles.samplePill} ${
                                  !sample.ok
                                    ? styles.critical
                                    : sample.ms >
                                        5000
                                      ? styles.critical
                                      : sample.ms >
                                          2000
                                        ? styles.watch
                                        : styles.healthy
                                }`}
                              >
                                R
                                {
                                  sample.round
                                }{" "}
                                {formatLatency(
                                  sample.ms,
                                )}
                              </span>
                            ),
                          )}
                        </div>
                      ) : null}
                    </div>
                  ),
                )}
              </div>
            </section>
          ),
        )}
      </div>

      <section
        className={
          styles.thresholdCard
        }
      >
        <div>
          <strong>
            {ui(
              "Health rules",
              "健康判断标准",
            )}
          </strong>

          <p>
            {ui(
              "Healthy: average ≤ 3s, slowest ≤ 5s and payload ≤ 5 MB. Watch: slower requests or payload above 5 MB. Critical: HTTP failure, average above 5s, a request above 10s, or payload above 20 MB.",
              "正常：平均 ≤ 3 秒、最慢 ≤ 5 秒、Payload ≤ 5 MB。超过这些进入注意；HTTP 失败、平均 > 5 秒、单次 > 10 秒或 Payload > 20 MB 为异常。",
            )}
          </p>

          <p>
            {ui(
              "Parameterized routes, OAuth callbacks and all write endpoints are intentionally excluded.",
              "所有需要 :id 的 API、OAuth callback，以及 POST / PATCH / DELETE 都刻意排除，避免健康检查修改系统数据。",
            )}
          </p>
        </div>

        <div
          className={
            styles.legend
          }
        >
          <span
            className={
              styles.legendHealthy
            }
          >
            Healthy
          </span>

          <span
            className={
              styles.legendWatch
            }
          >
            Watch
          </span>

          <span
            className={
              styles.legendCritical
            }
          >
            Critical
          </span>
        </div>
      </section>
    </div>
  );
}
