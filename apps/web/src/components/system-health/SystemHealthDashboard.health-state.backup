/* HEALTH_UI_V2_RENDER */

function HealthStatusBadge({
  status,
}: {
  status?: string;
}) {
  const value = (status || "unknown").toLowerCase();

  return (
    <span
      className={
        value === "healthy"
          ? "healthHealthy"
          : value === "critical"
            ? "healthCritical"
            : "healthWarning"
      }
    >
      {value}
    </span>
  );
}




type HealthSnapshot = {
  checkedAt: string;
  api?: unknown;
  database?: unknown;
  railway?: unknown;
  browserWorker?: unknown;
  assets?: unknown;
  calendar?: unknown;
  issues?: unknown[];
};


