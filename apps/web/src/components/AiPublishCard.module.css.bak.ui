.card {
  display: grid;
  gap: 16px;
  margin-top: 18px;
  padding: 20px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 18px;
  background: rgba(15, 23, 42, 0.72);
}

.heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.heading span {
  font-size: 12px;
  color: #94a3b8;
}

.heading h3 {
  margin: 4px 0 0;
  font-size: 18px;
}

.ready {
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(34, 197, 94, 0.12);
  color: #86efac !important;
}

.platforms {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.platforms label {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 12px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 12px;
  cursor: pointer;
}

.mode {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  padding: 5px;
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.8);
}

.mode button {
  border: 0;
  border-radius: 9px;
  padding: 10px;
  background: transparent;
  color: #94a3b8;
  cursor: pointer;
}

.mode .active {
  background: #312e81;
  color: #ffffff;
}

.scheduleField {
  display: grid;
  gap: 7px;
}

.scheduleField span {
  font-size: 12px;
  color: #94a3b8;
}

.scheduleField input {
  padding: 11px 12px;
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 10px;
  background: #0f172a;
  color: #ffffff;
}

.publishButton {
  border: 0;
  border-radius: 12px;
  padding: 13px 16px;
  background: linear-gradient(135deg, #7c3aed, #4f46e5);
  color: #ffffff;
  font-weight: 700;
  cursor: pointer;
}

.publishButton:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.error {
  margin: 0;
  color: #fca5a5;
  font-size: 13px;
}

.success {
  display: grid;
  gap: 9px;
  padding: 14px;
  border-radius: 12px;
  background: rgba(34, 197, 94, 0.08);
}

.success div {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
}

.success a {
  margin-top: 4px;
  color: #c4b5fd;
  font-weight: 600;
  text-decoration: none;
}
